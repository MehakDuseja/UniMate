GEMINI_API_KEY=

# Optional - only needed for the voice chat feature (agent/voice.py): speech
# input and spoken replies via the Fish Audio API. Get a key at
# https://fish.audio (separate paid account/quota from Gemini). Without this
# set, voice chat is unavailable but the rest of the app works normally.
FISH_API_KEY=

# Optional - adding this alone turns on LangSmith tracing for every graph run
# and every individual Gemini call (see src/config.py). Get a key at
# https://smith.langchain.com
LANGSMITH_API_KEY=

