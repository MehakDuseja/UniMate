GEMINI_API_KEY=
# Or use Google AI Studio / Vertex-style alias:
# GOOGLE_API_KEY=

OPENAI_API_KEY=

# Optional: force provider when both keys are set (openai | gemini).
# If unset: OpenAI is used when OPENAI_API_KEY is present, otherwise Gemini.
# LLM_PROVIDER=openai

# Optional model overrides
# OPENAI_CHAT_MODEL=gpt-4o-mini
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# On Vercel, set the same keys in Project Settings → Environment Variables.
# Writable DBs automatically use /tmp there (see src/config.py).

# Optional - adding this alone turns on LangSmith tracing for every graph run
# and every individual LLM call (see src/config.py). Get a key at
# https://smith.langchain.com
LANGSMITH_API_KEY=

# Flask session signing (change in production)
FLASK_SECRET_KEY=
